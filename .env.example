# Copy to .env.local and fill in. Values come from the Supabase dashboard:
# Project Settings -> API (URL and publishable key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only secret. Never prefix with NEXT_PUBLIC_.
# Supabase -> Connect -> Transaction pooler (port 6543), with your database password.
DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
